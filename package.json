{
  "name": "rockyprint",
  "version": "1.0.0",
  "description": "Gestión de pedidos para imprenta",
  "author": "Tu Nombre",
  "main": "app/main/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "electron-store": "^11.0.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.rockyprint.app",
    "asar": true,
    "directories": { "buildResources": "build" },
    "files": [
      "app/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "sql", "to": "sql", "filter": ["**/*"] },
      { "from": "assets", "to": "assets", "filter": ["**/*"] },
      { "from": ".", "to": ".", "filter": [".env"] }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/RockyPrint.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RockyPrint"
    },
    "mac": { "category": "public.app-category.productivity" },
    "linux": { "target": "AppImage", "category": "Utility" }
  }
}
